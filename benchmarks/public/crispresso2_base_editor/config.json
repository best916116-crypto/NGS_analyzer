{
  "runName": "CRISPResso2 EMX1 Base Editor Public FASTQ Benchmark",
  "dataset": {
    "name": "CRISPResso2 base-editor example",
    "sampleName": "emx1_base_editor",
    "description": "First 25,000 reads from an EMX1 base-editing experiment published as a CRISPResso2 example dataset.",
    "sourceDocsUrl": "https://docs.crispresso.com/latest/core/examples.html",
    "fastqUrl": "https://crispresso.com/static/demo/base_editor.fastq.gz",
    "file": "raw/base_editor.fastq.gz"
  },
  "reference": "GGCCCCAGTGGCTGCTCTGGGGGCCTCCTGAGTTTCTCATCTGTGCCCCTCCCTCCCTGGCCCAGGTGAAGGTGTGGTTCCAGAACCGGAGGACAAAGTACAAACGGCAGAAGCTGGAGGAGGAAGGGCCTGAGTCCGAGCAGAAGAAGAAGGGCTCCCATCACATCAACCGGTGGCGCATTGCCACGAAGCAGGCCAATGGGGAGGACATCGATGTCACCTCCAATGACTAGGGTGG",
  "assay": {
    "type": "cas",
    "spacer": "GAGTCCGAGCAGAAGAAGAA",
    "pam": "NGG",
